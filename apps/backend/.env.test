NODE_ENV=test
PORT=3001
CORS_ORIGIN=*

# 개발 DB(feelpick)와 분리된 e2e 전용 스키마. 같은 MySQL 컨테이너의 다른 데이터베이스.
DATABASE_URL="mysql://root:root@localhost:3307/feelpick_test"

# 테스트 전용 시크릿 (운영 시크릿 아님 — 커밋해도 무방)
JWT_SECRET="test-secret-key-at-least-16-characters"
JWT_EXPIRES_IN="15m"
# 리프레시 토큰 수명(일). 이 기간 동안은 재로그인 없이 세션이 이어진다.
REFRESH_TOKEN_TTL_DAYS=14

# SMS는 반드시 목(mock) 모드여야 한다 — e2e가 실제 문자를 보내면 안 된다.
# 빈 값으로 '명시'하는 게 중요하다. 키를 지워두면 ConfigModule이 .env로
# 폴백해 개발용 실제 키를 물 수 있다.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=
