    "/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The Health Check is successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "info": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up"
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "error": {
                      "type": "object",
                      "example": {},
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "details": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up"
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "The Health Check is not successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "error"
                    },
                    "info": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up"
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "error": {
                      "type": "object",
                      "example": {
                        "redis": {
                          "status": "down",
                          "message": "Could not connect"
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "details": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up"
                        },
                        "redis": {
                          "status": "down",
                          "message": "Could not connect"
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Liveness/readiness check (app + DB)",
        "tags": [
          "health"
        ]
      }
    }
  },
  "info": {
    "title": "Feel Pick API",
    "description": "Pick & vote API",
    "version": "0.0.1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RequestOtpDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "010-1234-5678",
            "description": "전화번호(하이픈 허용)"
          }
        },
        "required": [
          "phone"
        ]
      },
      "RequestOtpResponseDto": {
        "type": "object",
        "properties": {
          "devCode": {
            "type": "string",
            "nullable": true,
            "description": "개발 환경에서만 채워지는 인증번호(목 OTP). 운영에선 null.",
            "example": "123456"
          }
        },
        "required": [
          "devCode"
        ]
      },
      "VerifyOtpDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "010-1234-5678",
            "description": "전화번호(하이픈 허용)"
          },
          "code": {
            "type": "string",
            "example": "123456",
            "description": "6자리 인증번호"
          }
        },
        "required": [
          "phone",
          "code"
        ]
      },
      "VerifyOtpResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "nullable": true,
            "description": "기존 유저면 발급된 토큰, 신규 유저면 null(가입 진행 필요)."
          },
          "refreshToken": {
            "type": "string",
            "nullable": true,
            "description": "기존 유저면 리프레시 토큰, 신규 유저면 null."
          },
          "isNewUser": {
            "type": "boolean",
            "description": "가입 이력이 없는 신규 유저인지 여부."
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "isNewUser"
        ]
      },
      "Gender": {
        "type": "string",
        "enum": [
          "MALE",
          "FEMALE",
          "OTHER"
        ]
      },
      "SignupDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "010-1234-5678",
            "description": "전화번호(하이픈 허용)"
          },
          "birthday": {
            "type": "string",
            "example": "2000-09-20",
            "format": "date",
            "description": "생년월일 (ISO 날짜)"
          },
          "nickname": {
            "type": "string",
            "example": "아니근데옥지얌",
            "minLength": 1,
            "maxLength": 50
          },
          "gender": {
            "example": "FEMALE",
            "allOf": [
              {
                "$ref": "#/components/schemas/Gender"
              }
            ]
          },
          "agreeTerms": {
            "type": "boolean",
            "description": "이용약관 동의 (필수 — true가 아니면 가입 불가)",
            "example": true
          },
          "agreePrivacy": {
            "type": "boolean",
            "description": "개인정보처리방침 동의 (필수 — true가 아니면 가입 불가)",
            "example": true
          },
          "agreeMarketing": {
            "type": "boolean",
            "description": "마케팅 정보 수신 동의 (선택)",
            "default": false
          }
        },
        "required": [
          "phone",
          "birthday",
          "nickname",
          "gender",
          "agreeTerms",
          "agreePrivacy"
        ]
      },
      "TokenResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "짧게 사는 액세스 토큰(JWT). 기본 15분."
          },
          "refreshToken": {
            "type": "string",
            "description": "액세스 토큰 재발급용 리프레시 토큰. 재발급 시마다 새 값으로 회전한다."
          }
        },
        "required": [
          "accessToken",
          "refreshToken"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "발급받은 리프레시 토큰 원문(64자 hex)",
            "example": "a3f9c1..."
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "phone": {
            "type": "string",
            "description": "전화번호(정규화된 숫자만)",
            "example": "01012345678"
          },
          "birthday": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "description": "생년월일"
          },
          "displayName": {
            "type": "string"
          },
          "gender": {
            "nullable": true,
            "description": "성별 (가입 이전 데이터는 null일 수 있음)",
            "allOf": [
              {
                "$ref": "#/components/schemas/Gender"
              }
            ]
          },
          "isPremium": {
            "type": "boolean",
            "description": "프리미엄 구독 여부(임시)"
          },
          "createdAt": {
