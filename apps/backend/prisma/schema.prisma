// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// 성별. 가입 시 필수로 받지만, 기존 행 호환을 위해 컬럼은 nullable.
enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id          String    @id @default(uuid()) @db.VarChar(36)
  phone       String    @unique @db.VarChar(20)
  birthday    DateTime? @db.Date
  displayName String    @db.VarChar(50)
  gender      Gender?
  createdAt   DateTime  @default(now())

  // 약관 동의 시각(동의 여부 + 언제 동의했는지를 함께 남긴다 — 분쟁 시 증빙).
  // 이용약관·개인정보처리방침은 가입 필수, 마케팅 수신은 선택.
  termsAgreedAt     DateTime?
  privacyAgreedAt   DateTime?
  marketingAgreedAt DateTime?

  // 프로필(초이스 카드 표시용)
  // 대표 사진은 따로 두지 않는다 — 사진첩(photos)의 첫 장이 곧 대표 사진이다.
  bio        String? @db.VarChar(200)
  // 마이페이지 상단의 한 줄 상태("지금 기분이 어떠세요?").
  // bio(자기소개)와 달리 자주 바뀌는 값이라 필드를 분리한다.
  statusMessage String? @db.VarChar(100)
  distanceKm Int? // 목업: 나와의 거리(km). 위치 기능 도입 전 임시 값.
  interests  Json? // string[] 관심사 태그 (MySQL은 스칼라 배열 미지원 → Json)

  // 프리미엄 여부(임시). '가입하기' → true → 받은픽 사진 공개.
  isPremium Boolean @default(false)

  // 선택 기록 관계
  selectionsMade     Selection[] @relation("selector")
  selectionsReceived Selection[] @relation("selected")

  // 채팅 관계 (1:1 대화는 정렬된 쌍 userA<userB로 저장)
  conversationsA Conversation[] @relation("userA")
  conversationsB Conversation[] @relation("userB")
  messages       Message[]

  refreshTokens RefreshToken[]
  photos        UserPhoto[]
}

// 사진첩. 유저 사진의 유일한 출처다.
// sortOrder가 가장 작은 첫 장이 곧 대표 사진(응답의 photoUrl)이 된다.
model UserPhoto {
  id        String   @id @default(uuid()) @db.VarChar(36)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @db.VarChar(36)
  url       String   @db.VarChar(500)
  sortOrder Int      @default(0) // 오름차순 노출. 새 사진은 맨 뒤로.
  createdAt DateTime @default(now())

  @@index([userId, sortOrder])
}

// 액세스 토큰 재발급용 리프레시 토큰.
// 평문이 아니라 SHA-256 해시로 저장한다 — DB가 새도 토큰을 되살릴 수 없게.
// 재발급 시마다 옛 토큰을 revoke하고 새로 발급한다(회전, rotation).
model RefreshToken {
  id        String    @id @default(uuid()) @db.VarChar(36)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String    @db.VarChar(36)
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  revokedAt DateTime? // 회전으로 폐기됐거나 로그아웃된 시각
  createdAt DateTime  @default(now())

  @@index([userId])
}

// 전화번호 OTP 인증 코드(개발용 목). request-otp 시 생성, verify-otp 시 verified.
model PhoneVerification {
  id        String   @id @default(uuid()) @db.VarChar(36)
  phone     String   @db.VarChar(20)
  code      String   @db.VarChar(6)
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
}

// 카드 위에 제시되는 질문(타이틀). 예: "술 잘 먹을 것 같은 친구"
model Question {
  id        String   @id @default(uuid()) @db.VarChar(36)
  text      String   @db.VarChar(100)
  createdAt DateTime @default(now())

  selections    Selection[]
  conversations Conversation[]
}

// 어떤 질문에서 어떤 유저를 골랐는지 기록. (공개 API라 selector는 없을 수 있음 → nullable)
model Selection {
  id             String   @id @default(uuid()) @db.VarChar(36)
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId     String   @db.VarChar(36)
  selected       User     @relation("selected", fields: [selectedUserId], references: [id], onDelete: Cascade)
  selectedUserId String   @db.VarChar(36)
  selector       User?    @relation("selector", fields: [selectorUserId], references: [id], onDelete: SetNull)
  selectorUserId String?  @db.VarChar(36)
  createdAt      DateTime @default(now())

  @@index([questionId])
  @@index([selectedUserId])
  @@index([selectorUserId])
}

// 1:1 대화. 같은 두 사람은 대화 1개(정렬된 쌍 userA<userB로 저장 → @@unique).
model Conversation {
  id         String    @id @default(uuid()) @db.VarChar(36)
  userA      User      @relation("userA", fields: [userAId], references: [id], onDelete: Cascade)
  userAId    String    @db.VarChar(36)
  userB      User      @relation("userB", fields: [userBId], references: [id], onDelete: Cascade)
  userBId    String    @db.VarChar(36)
  question   Question? @relation(fields: [questionId], references: [id], onDelete: SetNull)
  questionId String?   @db.VarChar(36) // 소통 시작의 픽 주제(뱃지용)
  createdAt  DateTime  @default(now())
  messages   Message[]

  @@unique([userAId, userBId]) // 중복 대화 방지
  @@index([userAId])
  @@index([userBId])
}

// 대화 안의 메시지. DB 영속 후 소켓 브로드캐스트.
model Message {
  id             String       @id @default(uuid()) @db.VarChar(36)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String       @db.VarChar(36)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderId       String       @db.VarChar(36)
  text           String       @db.VarChar(1000)
  readAt         DateTime? // 안읽음 뱃지용
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}
