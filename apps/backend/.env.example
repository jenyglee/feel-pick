NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

DATABASE_URL="mysql://root:root@localhost:3307/feelpick"

JWT_SECRET="change-me-in-production-use-openssl-rand-hex-32"
JWT_EXPIRES_IN="1d"

# 전화번호 OTP 인증코드 유효시간(초). 기본 300(5분).
OTP_TTL_SECONDS=300

# --- SMS(Solapi) ---
# 셋 다 채우면 실제 문자를 보내고, 하나라도 비면 목(mock) 모드로 동작한다.
# 목 모드에서는 개발 환경 한정으로 응답 devCode / 서버 로그에 인증번호가 찍힌다.
# SOLAPI_SENDER는 Solapi 콘솔에 "사전 등록"된 발신번호여야 한다(미등록 번호는 발송 거부).
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=
